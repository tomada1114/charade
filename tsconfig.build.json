{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "noEmit": false,
    "declaration": true,

    // The package ships no source maps (issue #33): `src/` is not in the
    // tarball, and maps were the largest files in it. `check-package.mjs`
    // rejects any `.map` it finds.
    "sourceMap": false,
    "inlineSourceMap": false,
    "declarationMap": false,
    "isolatedDeclarations": true,

    // The published artifact is TypeScript output only; repository automation
    // never ships.
    "allowJs": false,
    "checkJs": false,

    // The node-library profile may use `node:` builtins in src. The universal
    // profile replaces this with `"types": []` so a Node-only import fails the
    // build instead of silently narrowing where the package can run.
    "types": ["node"],
    "lib": ["ES2023"]
  },
  "include": ["src"],
  "exclude": ["tests", "scripts", "**/*.test.ts"]
}
